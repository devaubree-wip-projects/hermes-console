# Postgres — shared dev infra container `infra-postgres`, database hermes_console
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/hermes_console

# Raccourci de connexion local, ignoré en production.
HERMES_DEV_LOGIN_EMAIL=demo@hermes.local
HERMES_DEV_LOGIN_PASSWORD=demo-password

# Adresses qui EXPLOITENT cette Console, séparées par des virgules. Elles seules
# peuvent s'inscrire sans invitation et créer plusieurs organisations : c'est le
# geste de mise en service d'un nouveau client. Tout autre compte est limité à
# une organisation et doit avoir été invité.
# Laisser vide sur une installation mono-client. Volontairement hors base : voir
# apps/web/src/lib/operator.ts.
HERMES_OPERATOR_EMAILS=

# Clé du fournisseur d'inférence, passée au runtime Hermes (infra/dev/compose.yaml).
# Image runtime : latest par défaut (tirée et nettoyée à chaque make dev).
HERMES_IMAGE_TAG=latest

# Renseigner celle qui correspond à data/hermes/config.yaml (model.base_url).
# La config par défaut utilise OpenRouter -> OPENROUTER_API_KEY. Requis pour que
# les runs agentiques réels aboutissent (sinon "No inference provider configured").
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local file storage for workspace uploads
UPLOAD_DIR=./data/uploads

# Public base URL of the Console — used to build links sent by email
# (password reset, invitations). Dev default: http://localhost:3010
HERMES_CONSOLE_URL=http://localhost:3010

# Transactional email (password reset, team invitations).
# Dev: shared Mailpit container (infra-mailpit, SMTP 1025, UI http://localhost:8025).
# Prod: your real SMTP relay. SMTP_USER/SMTP_PASSWORD may be omitted when the relay
# needs no auth (e.g. Mailpit). SMTP_SECURE=true only for implicit TLS on port 465.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Hermes Console <no-reply@hermes-console.local>

# Support address surfaced in the app footer (public, exposed to the browser).
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.invalid

# Les credentials d'inférence ne vivent PAS dans ce fichier.
# Hermes les charge depuis le profil de l'agent :
# ~/.hermes/profiles/<nom-du-profil>/.env
# Exemple : OPENAI_API_KEY=sk-...

# Go Edge gateway. Next.js never talks directly to the Hermes dashboard.
HERMES_GATEWAY_LISTEN=127.0.0.1:8787
HERMES_DEFAULT_INSTALLATION_ID=local-default
HERMES_RUNTIME_KIND=systemwide
HERMES_DATA_DIR=./data/hermes
HERMES_WORKSPACE_DIR=./data/workspace
HERMES_WORKSPACE_READ_ONLY=true
HERMES_WORK_DIR=./data/work
HERMES_BACKUP_DIR=./data/backups
HERMES_BACKUP_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
HERMES_BACKUP_RESTORE_ENABLED=true
HERMES_DEFAULT_INSTALLATION_NAME=Hermes local
HERMES_DEFAULT_GATEWAY_MODE=direct
HERMES_DEFAULT_GATEWAY_URL=http://127.0.0.1:8787
# Persisted-session invalidations: debounce filesystem write bursts and use a
# slow broker-side reconciliation as a safety net. Set reconciliation to 0 to disable it.
HERMES_SESSION_CHANGE_DEBOUNCE_MS=200
HERMES_SESSION_RECONCILE_MS=0

# Hermes full dashboard/runtime, kept server-side.
HERMES_RUNTIME_URL=http://127.0.0.1:9119
HERMES_RUNTIME_WS=ws://127.0.0.1:9119/api/ws
# Optional. When empty, Next and the broker share a loopback-only development token.
HERMES_DASHBOARD_SESSION_TOKEN=

# Public origin the BROWSER uses to open the agent WebSocket, when the Edge is
# only reachable by its Docker service name from the server. Overrides just the
# WebSocket URL of the local runtime; server-to-Edge calls keep using
# HERMES_DEFAULT_GATEWAY_URL directly, so they never bounce off the reverse proxy
# (whose IP allowlist would reject them). Leave empty when the gateway URL is
# already reachable from a browser, as it is in local development.
HERMES_PUBLIC_GATEWAY_URL=

# Shows the "Atelier Lumière" demo accounts on the login page, prefilled on click.
# Always on when NODE_ENV=development, so this flag only matters for a deployed
# instance. Those accounts share a public password and one of them owns the org:
# test environments only, never an instance with real users. install-server.sh
# forces this back to false unless it is run with --demo-accounts.
HERMES_DEMO_ACCOUNTS=false

# Must be shared by Next.js and the Go gateway. Use distinct random values in production.
HERMES_GATEWAY_ENV=development
HERMES_LOG_LEVEL=info
HERMES_LOG_FORMAT=pretty
HERMES_LOG_HTTP=false
HERMES_GATEWAY_TICKET_SECRET=change-me-ticket-secret-at-least-24-characters
HERMES_GATEWAY_SERVICE_SECRET=change-me-service-secret-at-least-24-characters
HERMES_GATEWAY_DERIVE_SECRETS=true
# Chiffre au repos les secrets que la Console détient pour un Edge enrôlé
# (table runtime_installation_secrets). Obligatoire en production ; en développement,
# une clé est dérivée du secret de service ci-dessus si celle-ci est vide.
# ⚠️ Perdre cette clé impose de ré-enrôler les Edge concernés : voir
# La sauvegarder avec le reste des secrets de production.
HERMES_INSTALLATION_SECRET_KEY=

# Sortie de secours des réglages d'instance. Les valeurs surchargées depuis
# Réglages › Instance (table console_settings) priment normalement sur ce fichier.
# Passer cette variable à true les ignore toutes et rend la main au .env — la seule
# façon de récupérer une instance rendue muette par un réglage erroné (SMTP cassé =
# plus aucun email de réinitialisation) sans ouvrir psql. Elle-même n'est jamais
# surchargeable, sinon la soupape se refermerait sur elle-même.
HERMES_SETTINGS_DISABLE_OVERRIDES=false
# Route conteneur -> hôte utilisée par l'Edge pour joindre la Console. Distincte de
# HERMES_CONSOLE_URL plus haut (URL navigateur des emails) : une valeur en 127.0.0.1
# désigne l'intérieur du namespace réseau du conteneur, où Next.js ne tourne pas, et
# le WorkExecutor n'obtient plus aucune tâche. Le défaut du compose suffit : à laisser
# vide sauf besoin particulier.
HERMES_EDGE_CONSOLE_URL=
HERMES_WORK_ENABLED=true
HERMES_WORK_CAPACITY=1
HERMES_WORK_POLL_INTERVAL_MS=2000
HERMES_WORK_HEARTBEAT_INTERVAL_MS=10000
HERMES_WORK_ROOT=/work
HERMES_WORK_RESOURCE_MAX_BYTES=20971520
HERMES_WORK_RESOURCE_TOTAL_MAX_BYTES=104857600
HERMES_WORK_RESOURCE_MAX_COUNT=32
# Filesystem grants are opt-in and exposed read-only to Edge only.
HERMES_FS_GRANTS_ENABLED=false
HERMES_HOST_GRANT_ROOT=./data/grants/disabled

# compose.edge.yaml — Edge conteneurisé devant un Hermes installé sur l'hôte.
# Le même chemin absolu est utilisé dans le conteneur et par Hermes sur l'hôte.
# L'init Compose le crée en mode 700 avec ce UID/GID. Sans valeur explicite, il
# utilise $HERMES_SYSTEM_HOME/.hermes-console/work pour les upgrades existants.
HERMES_UID=1000
HERMES_GID=1000
HERMES_SYSTEM_HOME=/home/hermes/.hermes
HERMES_EDGE_IDENTITY_DIR=./data/edge-identity
HERMES_HOST_WORK_ROOT=/home/hermes/.hermes-console/work

# Product rollout flags. Set any flag to false to stop the corresponding new
# enqueues/projections while retaining all persisted tasks and runs.
WORK_CONTROL_PLANE_ENABLED=true
WORK_EDGE_EXECUTOR_ENABLED=true
WORK_RUN_PLANS_ENABLED=true
WORK_INTERVENTIONS_ENABLED=true
WORK_AUTOMATIONS_ENABLED=true
WORK_AGENT_TEAMS_ENABLED=true
WORK_AUTOMATION_CRON_SECRET=replace-with-a-random-scheduler-secret
HERMES_INSTALLATION_ID=local-default
# UUID de la ligne runtime_installations servie par cet Edge — visible après l'onboarding
# (SELECT id FROM runtime_installations). La Console résout l'installation par clé
# primaire et rejette une requête Work qui n'en nomme aucune, donc l'Edge refuse de
# démarrer sans cette valeur. Un Edge = une installation = un tenant.
HERMES_WORK_INSTALLATION_ID=
HERMES_ALLOWED_ORIGINS=http://127.0.0.1:3010,http://localhost:3010

# Relay Go optionnel pour une Console déployée et des Edge sans port entrant.
HERMES_RELAY_URL=wss://127.0.0.1:8790/v1/relay/connect
HERMES_RELAY_PUBLIC_URL=https://127.0.0.1:8790
HERMES_RELAY_IDENTITY_SECRET=change-me-relay-identity-secret-at-least-24-characters
HERMES_RELAY_CERT_DIR=./data/relay/certs
HERMES_RELAY_STATE_DIR=./data/relay/state
HERMES_RELAY_MAX_CONNECTIONS=1024
HERMES_RELAY_MAX_CONNECTIONS_PER_TENANT=128
HERMES_RELAY_MAX_FRAME_BYTES=4194304
# Per-request timeout for calls tunneled through the relay. Raise it for slow
# inference; the old hardcoded 15s cut long agent turns on relayed installations.
HERMES_RELAY_REQUEST_TIMEOUT_SECONDS=120

# Telegram — notifications Work sortantes historiques uniquement.
# Le canal Telegram entrant est configuré nativement dans chaque profil Hermes ;
# /work transite par l'Edge local sans webhook Telegram ni UUID dans cet env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Déploiement production — infra/prod/compose.console.yaml (Console + Postgres + Caddy).
# Valeurs dédiées à la prod : ne jamais réutiliser les identifiants/secrets dev ci-dessus.
POSTGRES_USER=hermes_console
POSTGRES_PASSWORD=replace-with-a-strong-random-password
POSTGRES_DB=hermes_console
HERMES_CONSOLE_DOMAIN=console.example.com
# Déploiement privé : IP/CIDR autorisées à joindre la Console, séparées par des
# espaces. Tout le reste reçoit 403 depuis Caddy, sans atteindre l'application.
# ⚠️ Une valeur vide bloque TOUT LE MONDE (comportement vérifié) : install-server.sh
# refuse d'installer sans allowlist. Élargir via --allow-ip=<ip,…>.
HERMES_ALLOWED_IPS=
HERMES_CONSOLE_WEB_IMAGE=hermes-console-web:latest
# Dossier hôte des sauvegardes Postgres (voir infra/prod/backup-postgres.sh et
# docs/operations/backups.md — différent de HERMES_BACKUP_DIR qui couvre les
# sauvegardes runtime Hermes gérées par scripts/maintain-runtime-backups.ts).
HERMES_DB_BACKUP_DIR=./backups/postgres
HERMES_DB_BACKUP_RETENTION_DAYS=14
