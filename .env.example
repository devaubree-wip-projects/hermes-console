# Postgres — shared dev infra container `infra-postgres`, database hermes_console
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/hermes_console

# Default Hermes gateway used to prefill new workspaces (OpenAI-compatible /v1)
HERMES_DEFAULT_BASE_URL=http://localhost:8645/v1
# HERMES_DEFAULT_API_KEY=local-secret
HERMES_MODEL=hermes

# Local file storage for workspace uploads
UPLOAD_DIR=./data/uploads
