{
  "name": "hermes-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3010",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "bun test --path-ignore-patterns=e2e/**",
    "test:e2e:seed": "bun run db:migrate:runtime && bun run e2e/seed.ts",
    "test:e2e": "bun run test:e2e:seed && bunx playwright test",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:seed:demo": "bun run src/db/seed.ts",
    "db:reset": "bun run scripts/reset-product-data.ts",
    "mock:hermes": "bun run scripts/mock-hermes.ts",
    "test:telegram-control": "python3 -m unittest hermes-extensions/hermes-console-control/test_plugin.py",
    "telegram-control:install": "bun run scripts/install-hermes-console-control.ts",
    "runtime:import-systemwide": "bun run scripts/import-hermes-systemwide.ts",
    "runtime:maintain-backups": "bun run scripts/maintain-runtime-backups.ts",
    "dev:gateway": "go run ./cmd/hermes-gateway",
    "dev:bridge": "bun run dev:gateway",
    "dev:agent": "concurrently -k -n next,gateway -c cyan,magenta \"bun run dev\" \"bun run dev:gateway\"",
    "test:gateway": "go test -race ./gateway/... ./cmd/...",
    "db:migrate:product": "bun run scripts/migrate-product-model.ts && bun run scripts/migrate-runtime-installations.ts",
    "db:migrate:runtime": "bun run scripts/migrate-runtime-installations.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3",
    "@ai-sdk/google": "^3",
    "@ai-sdk/mcp": "1.0.55",
    "@ai-sdk/openai": "^3",
    "@ai-sdk/openai-compatible": "^2",
    "@ai-sdk/react": "^3",
    "@assistant-ui/core": "^0.2.19",
    "@assistant-ui/react": "^0.14.23",
    "@assistant-ui/react-ai-sdk": "^1.3.37",
    "@assistant-ui/react-lexical": "^0.2.3",
    "@assistant-ui/react-markdown": "^0.14.4",
    "@assistant-ui/store": "^0.2.19",
    "@radix-ui/react-slot": "^1.2.3",
    "@react-pdf/renderer": "^4.5.1",
    "ai": "6.0.216",
    "assistant-stream": "^0.3.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.13.0",
    "shiki": "^4.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.11",
    "zod": "^4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
