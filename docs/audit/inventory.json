  "scripts": {
    "apps/gateway/package.json": {
      "build": "mkdir -p build && go build -trimpath -o build/hermes-gateway ./cmd/hermes-gateway",
      "dev": "go run ./cmd/hermes-gateway",
      "test": "go test -race ./..."
    },
    "apps/web/package.json": {
      "build": "next build",
      "dev": "next dev --port 3010",
      "lint": "eslint",
      "start": "next start",
      "test": "bun test --path-ignore-patterns=e2e/**",
      "test:e2e": "bun run test:e2e:seed && bunx playwright test",
      "test:e2e:seed": "bun run ../../scripts/migrate-runtime-installations.ts && bun run e2e/seed.ts",
      "typecheck": "tsc --noEmit"
    },
    "package.json": {
      "audit:architecture": "bun run tools/audit-architecture.ts",
      "build": "bun --cwd=apps/web run build",
      "build:all": "bun run build:shared && bun run build:web && bun run build:gateway",
      "build:gateway": "bun --cwd=apps/gateway run build",
      "build:shared": "bun --cwd=packages/shared run build",
      "build:web": "bun --cwd=apps/web run build",
      "check": "bun run contracts:verify && bun run typecheck && bun run lint && bun run test && bun run test:gateway && bun run build:all",
      "contracts:verify": "bun run tools/verify-contracts.ts",
      "db:migrate:product": "bun run scripts/migrate-product-model.ts && bun run scripts/migrate-runtime-installations.ts",
      "db:migrate:runtime": "bun run scripts/migrate-runtime-installations.ts",
      "db:push": "bunx --bun drizzle-kit push --config=apps/web/drizzle.config.ts",
      "db:reset": "bun run scripts/reset-product-data.ts",
      "db:seed:demo": "bun run apps/web/src/db/seed.ts",
      "dev": "bun --cwd=apps/web run dev",
      "dev:agent": "bunx concurrently -k -n next,gateway -c cyan,magenta \"bun run dev\" \"bun run dev:gateway\"",
      "dev:bridge": "bun run dev:gateway",
      "dev:gateway": "bun --cwd=apps/gateway run dev",
      "lint": "bun run lint:web && bun run lint:shared",
      "lint:shared": "bun --cwd=packages/shared run lint",
      "lint:web": "bun --cwd=apps/web run lint",
      "mock:hermes": "bun run scripts/mock-hermes.ts",
      "runtime:import-systemwide": "bun run scripts/import-hermes-systemwide.ts",
      "runtime:maintain-backups": "bun run scripts/maintain-runtime-backups.ts",
      "start": "bun --cwd=apps/web run start",
      "telegram-control:install": "bun run scripts/install-hermes-console-control.ts",
      "test": "bun run test:web && bun run test:shared",
      "test:e2e": "bun --cwd=apps/web run test:e2e",
      "test:e2e:seed": "bun --cwd=apps/web run test:e2e:seed",
      "test:gateway": "bun --cwd=apps/gateway run test",
      "test:shared": "bun --cwd=packages/shared run test",
      "test:telegram-control": "python3 -m unittest apps/web/hermes-extensions/hermes-console-control/test_plugin.py",
      "test:web": "bun --cwd=apps/web run test",
      "typecheck": "bun run typecheck:web && bun run typecheck:shared",
      "typecheck:shared": "bun --cwd=packages/shared run typecheck",
      "typecheck:web": "bun --cwd=apps/web run typecheck"
    },
    "packages/shared/package.json": {
      "build": "tsc --noEmit",
      "lint": "tsc --noEmit",
      "test": "bun test",
      "typecheck": "tsc --noEmit"
    }
  },
