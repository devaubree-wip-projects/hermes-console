{
  "name": "@hermes-console/web",
  "version": "0.1.0",
  "private": true,
  "description": "Application Next.js du cockpit Hermes Console : UI produit, auth/RBAC et APIs tenant.",
  "scripts": {
    "dev": "next dev --port 3010",
    "dev:e2e": "NEXT_DIST_DIR=.next-e2e HERMES_DISABLE_RATE_LIMIT=1 next dev --port 3198",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "bun test --path-ignore-patterns=e2e/**",
    "test:e2e:seed": "bun --env-file=../../.env run ../../scripts/migrate-runtime-installations.ts && bun --env-file=../../.env run ../../scripts/migrate-work-control-plane.ts && bun --env-file=../../.env run ../../scripts/migrate-tenant-boundary.ts && bun --env-file=../../.env run e2e/seed.ts",
    "test:e2e": "bun run test:e2e:seed && bun --env-file=../../.env x playwright test",
    "test:e2e:real": "E2E_REAL_WORK=1 bun run test:e2e:seed && E2E_REAL_WORK=1 bun --env-file=../../.env x playwright test work-real.spec.ts work-real-assign.spec.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3",
    "@ai-sdk/google": "^3",
    "@ai-sdk/mcp": "1.0.55",
    "@ai-sdk/openai": "^3",
    "@ai-sdk/openai-compatible": "^2",
    "@ai-sdk/react": "^3",
    "@assistant-ui/core": "^0.2.19",
    "@assistant-ui/react": "^0.14.23",
    "@assistant-ui/react-ai-sdk": "^1.3.37",
    "@assistant-ui/react-lexical": "^0.2.3",
    "@assistant-ui/react-markdown": "^0.14.4",
    "@assistant-ui/store": "^0.2.19",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@hermes-console/shared": "workspace:*",
    "@radix-ui/react-slot": "^1.2.3",
    "@react-pdf/renderer": "^4.5.1",
    "ai": "6.0.216",
    "assistant-stream": "^0.3.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.13.0",
    "shiki": "^4.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.11",
    "zod": "^4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19",
    "@types/react-dom": "19",
    "concurrently": "^9.1.2",
    "drizzle-kit": "0.31.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
